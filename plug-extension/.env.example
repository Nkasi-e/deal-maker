# DealMaker – extension owner API keys (used at build time)
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# Then run: pnpm run build

# OpenRouter (one key for many models; used first if set)
# Get a key at https://openrouter.ai
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI (used if OpenRouter key is not set)
# Get a key at https://platform.openai.com
VITE_OPENAI_API_KEY=

# Price comparison API (optional; leave blank for demo mode)
VITE_PRICE_API_KEY=
