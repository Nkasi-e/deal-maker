{
  "manifest_version": 3,
  "name": "DealMaker",
  "description": "Detect prices, compare deals, and get negotiation insights directly on product and SaaS pricing pages.",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DealMaker",
    "default_popup": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}

