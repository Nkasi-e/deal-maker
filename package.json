{
  "name": "dealmaker-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "frontend",
    "plug-extension"
  ],
  "scripts": {
    "dev:frontend": "pnpm --filter dealmaker-ui dev",
    "dev:extension": "pnpm --filter dealmaker-extension dev",
    "build:frontend": "pnpm --filter dealmaker-ui build",
    "build:extension": "pnpm --filter dealmaker-extension build"
  }
}
